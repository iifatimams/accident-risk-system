.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.DS_Store
.env
build/
dist/
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
artifacts/*
!artifacts/.gitkeep

# Local hardware recordings (GPS and wearable data)
/data/recordings/

# Generated synthetic MetaDrive frames/telemetry (synthetic_data/generate_scenarios.py);
# reproducible from the generator, never evidence of real-world performance.
/data/synthetic/

# Swift package build output (never source or test evidence)
/ios/.build/

# Per-user Xcode IDE state, not project source
*.xcuserstate
ios/RoadSense.xcodeproj/project.xcworkspace/xcuserdata/

# Live runtime database; mutates on every app run, not source or demo-fixture
# data that belongs in version control.
data/app.sqlite3
data/app.sqlite3-shm
data/app.sqlite3-wal
